# Variables de entorno de las Cloud Functions de Attra (EJEMPLO).
# Copia este archivo a `.env` (o `.env.attra-database`) y rellena los valores.
# El `.env` real está gitignored: NUNCA subas claves al repositorio.

# --- Google Places API (Attra Plans, Fase 2) ---
# Key restringida a "Places API (New)". Si falta, el generador de planes usa
# fallback (tipo de plan sin lugares reales) y NO llama a Google (coste 0).
# Además requiere el flag `date_plans_places_enabled: true` en config/featureFlags.
GOOGLE_PLACES_API_KEY=

# --- Spotify (integración de Ajustes) ---
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
